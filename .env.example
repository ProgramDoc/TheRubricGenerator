# The AI Researcher — Environment Variables
# Copy this to .env and fill in your values

# ─── Required ───
ANTHROPIC_API_KEY=sk-ant-...          # Claude API (generator + judge agents)
OPENAI_API_KEY=sk-...                 # GPT-5.4 (participant model)
GEMINI_API_KEY=...                    # Gemini 3.1/Pro (participant model)
ADMIN_SECRET=...                      # Secret code for admin login (/api/auth/admin)

# ─── Billing (Stripe) ───
STRIPE_SECRET_KEY=sk_test_...         # Stripe API key (credit packs + subscriptions)
STRIPE_WEBHOOK_SECRET=whsec_...       # Stripe webhook signature verification

# ─── Optional: Additional Models ───
MOONSHOT_API_KEY=...                  # Kimi K2 Thinking (Moonshot AI)

# ─── Optional: PubMed ───
NCBI_API_KEY=...                      # Boosts PubMed rate limit (3/s → 10/s)

# ─── Optional: Email (Password Reset) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=app-password
SMTP_FROM=noreply@yourdomain.com
APP_BASE_URL=https://your-app.onrender.com

# ─── Optional: SSO ───
SSO_SECRET=...                        # HMAC signing key for Annotator SSO
ANNOTATOR_URL=https://ogai-annotator.onrender.com

# ─── Optional: Daily Scheduler ───
DAILY_ENABLED=true                    # Enable/disable daily challenges
DAILY_MAX_PAPERS=10                   # Papers per daily challenge
DAILY_TIMEZONE=America/Los_Angeles    # Scheduler timezone
DAILY_HOUR=7                          # Hour to run (in timezone)

# ─── Optional: Self-Improvement ───
SKILL_EXPERIMENT_BUDGET=5             # Max experiments per improvement cycle
SKILL_IMPROVEMENT_ENABLED=true

# ─── Optional: Render ───
RENDER_DATA_DIR=/var/data             # Persistent disk path
OBSIDIAN_VAULT_DIR=/var/data/obsidian_vault
